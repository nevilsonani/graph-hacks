# Local Docker (default)
FALKOR_HOST=localhost
FALKOR_PORT=6379
FALKOR_USERNAME=
FALKOR_PASSWORD=
FALKOR_SSL=false
GRAPH_NAME=tracewire

# FalkorDB Cloud (no Docker): paste Connectivity host/port + Instance Details user/password.
# Free Cloud instances do not use TLS — keep FALKOR_SSL=false.
# FALKOR_HOST=your-instance.falkordb.cloud
# FALKOR_PORT=12345
# FALKOR_USERNAME=falkordb
# FALKOR_PASSWORD=paste-here
# FALKOR_SSL=false

# Optional. ChatGPT free website will NOT work. Only platform.openai.com API keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
